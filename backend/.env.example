# Copia este archivo a ".env" y completa tus propios valores.
# NUNCA subas el archivo ".env" real a git (ya está en .gitignore).

# --- Base de datos (usuario de la APP, con privilegios mínimos —
# ver backend/sql/02_usuario_app_minimo.sql — NUNCA el dueño del esquema) ---
DB_USER=turismouq_app
DB_PASSWORD="cambia_esto_por_la_clave_de_turismouq_app"
DB_CONNECT_STRING=localhost:1521/XEPDB1

# --- Servidor ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5174

# URL publica del BACKEND, para que Wompi pueda alcanzarlo desde internet.
# En desarrollo se obtiene con un tunel:
#   cloudflared tunnel --url http://127.0.0.1:4000
# Hacen falta dos cosas de aqui:
#   1. El webhook: registra <PUBLIC_URL>/api/pagos/wompi/webhook en el panel de
#      Wompi (Desarrollo > Programadores > URL de Eventos).
#   2. La vuelta del checkout: Wompi esta detras de AWS CloudFront, que
#      responde 403 a cualquier URL con "localhost" dentro. Por eso el
#      redirect-url apunta a <PUBLIC_URL>/api/pagos/retorno, que reenvia al
#      navegador hacia FRONTEND_URL con un 302.
# Un tunel gratuito cambia de URL cada vez que se reinicia: hay que
# actualizarla aqui Y en el panel de Wompi.
PUBLIC_URL=https://cambia-esto.trycloudflare.com

# --- Autenticación (JWT en cookie httpOnly) ---
# Genera un valor aleatorio largo, por ejemplo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_valor_aleatorio_largo
JWT_EXPIRES_IN=7d

# --- Verificacion anti-bot (Cloudflare Turnstile) ---
# Se crea gratis en https://dash.cloudflare.com > Turnstile > Add site.
# Da DOS claves: la publica ("Site Key") va en frontend/.env como
# VITE_TURNSTILE_SITE_KEY, y la privada ("Secret Key") va aqui.
# Si esta variable falta: en desarrollo la verificacion se OMITE con un aviso
# en consola; en produccion se rechaza toda peticion de autenticacion, para que
# un despliegue mal configurado no se quede sin la defensa en silencio.
# Este valor es la clave de PRUEBA oficial de Cloudflare ("siempre aprueba"):
# publica, documentada y valida en cualquier dominio, asi el proyecto arranca
# sin crear cuenta. Sustituyela por la tuya para tener proteccion de verdad.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Wompi (sandbox) ---
# Los obtienes al crear una cuenta de comercio de pruebas en https://comercios.wompi.co/
# (o en la consola de sandbox de Wompi). Empiezan con "pub_test_" / "prv_test_".
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxxxxxxxxxx

# Poner en 1 SOLO mientras se use un tunel (cloudflared) o un proxy delante:
# hace que el limite de intentos y Turnstile vean la IP real del cliente.
TRUST_PROXY=0
