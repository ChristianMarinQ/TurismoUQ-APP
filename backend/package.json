{
  "name": "turismouq-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API de TurismoUQ (Node/TypeScript) sobre la misma base de datos Oracle del proyecto académico TurismoUQ.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "oracledb": "^6.5.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.9",
    "@types/oracledb": "^7.0.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
